# Production Environment Configuration Example
# Copy this to .env.production and fill in your values

# Convex Cloud URL (required)
# Get this from your Convex dashboard: https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-project-name.convex.cloud

# LLM Configuration - Choose ONE provider:

# Option 1: GLM (智谱)
LLM_API_URL=https://open.bigmodel.cn
LLM_API_KEY=your-glm-api-key
LLM_MODEL=glm-4-flash
LLM_EMBEDDING_MODEL=embedding-3

# Option 2: OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 3: Ollama (requires self-hosted Ollama server)
# OLLAMA_HOST=http://your-ollama-server:11434
# OLLAMA_MODEL=llama3:latest
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
