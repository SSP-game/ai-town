{
  "title": "Psychological Well-being Survey",
  "description": "This survey helps us understand your current mental and emotional state. Your responses are confidential and will be used for research purposes only.",
  "sections": [
    {
      "id": "mood_emotions",
      "title": "Mood & Emotions",
      "color": "blue",
      "questions": [
        {
          "id": "currentMood",
          "type": "scale",
          "label": "How would you describe your current mood?",
          "description": "Rate your overall mood right now",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "Very Sad",
          "highLabel": "Very Happy",
          "defaultValue": 3
        },
        {
          "id": "stressLevel",
          "type": "scale",
          "label": "How stressed do you feel?",
          "description": "Rate your current stress level",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "No Stress",
          "highLabel": "Extremely Stressed",
          "defaultValue": 3
        },
        {
          "id": "anxietyLevel",
          "type": "scale",
          "label": "How anxious do you feel?",
          "description": "Rate your current anxiety level",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "No Anxiety",
          "highLabel": "Extremely Anxious",
          "defaultValue": 3
        },
        {
          "id": "energyLevel",
          "type": "scale",
          "label": "How energetic do you feel?",
          "description": "Rate your current energy level",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "Very Tired",
          "highLabel": "Very Energetic",
          "defaultValue": 3
        }
      ]
    },
    {
      "id": "social_tendencies",
      "title": "Social Tendencies",
      "color": "green",
      "questions": [
        {
          "id": "socialPreference",
          "type": "choice",
          "label": "How would you describe yourself socially?",
          "description": "Choose the option that best describes you",
          "required": true,
          "options": [
            {
              "value": "introvert",
              "label": "Introvert",
              "description": "Prefer solitude, feel drained by social interaction, need alone time to recharge"
            },
            {
              "value": "ambivert",
              "label": "Ambivert",
              "description": "Balanced between introvert and extrovert, comfortable in both social and solitary situations"
            },
            {
              "value": "extrovert",
              "label": "Extrovert",
              "description": "Energized by social interaction, enjoy being around people, prefer group activities"
            }
          ],
          "defaultValue": "ambivert"
        },
        {
          "id": "socialAnxiety",
          "type": "scale",
          "label": "How anxious do you feel in social situations?",
          "description": "Rate your comfort level when interacting with others",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "Very Comfortable",
          "highLabel": "Very Anxious",
          "defaultValue": 3
        }
      ]
    },
    {
      "id": "life_satisfaction",
      "title": "Life Satisfaction",
      "color": "purple",
      "questions": [
        {
          "id": "lifeSatisfaction",
          "type": "scale",
          "label": "How satisfied are you with your life?",
          "description": "Rate your overall life satisfaction",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "Very Dissatisfied",
          "highLabel": "Very Satisfied",
          "defaultValue": 3
        },
        {
          "id": "sleepQuality",
          "type": "scale",
          "label": "How would you rate your sleep quality?",
          "description": "Rate the quality of your sleep over the past week",
          "required": true,
          "min": 1,
          "max": 5,
          "lowLabel": "Very Poor",
          "highLabel": "Very Good",
          "defaultValue": 3
        }
      ]
    },
    {
      "id": "reflections",
      "title": "Reflections (Optional)",
      "color": "yellow",
      "questions": [
        {
          "id": "recentChallenges",
          "type": "text",
          "label": "What challenges have you faced recently?",
          "description": "",
          "required": false,
          "multiline": true,
          "rows": 3,
          "placeholder": "Share any recent difficulties or obstacles..."
        },
        {
          "id": "positiveExperiences",
          "type": "text",
          "label": "What positive experiences have you had recently?",
          "description": "",
          "required": false,
          "multiline": true,
          "rows": 3,
          "placeholder": "Share any positive moments or achievements..."
        },
        {
          "id": "futureGoals",
          "type": "text",
          "label": "What are your goals for the near future?",
          "description": "",
          "required": false,
          "multiline": true,
          "rows": 3,
          "placeholder": "Share your aspirations and goals..."
        }
      ]
    },
    {
      "id": "additional_questions",
      "title": "Additional Questions (Examples)",
      "color": "pink",
      "questions": [
        {
          "id": "spendingHabits",
          "type": "choice",
          "label": "Do you have a spending plan/budget?",
          "description": "Select the option that best describes your spending habits",
          "required": false,
          "options": [
            {
              "value": "daily",
              "label": "Daily tracking, strict budget",
              "description": "I record every expense and follow a detailed daily budget plan"
            },
            {
              "value": "weekly",
              "label": "Weekly tracking, moderate budget",
              "description": "I check my spending weekly and follow a general budget framework"
            },
            {
              "value": "occasional",
              "label": "Occasional tracking, flexible budget",
              "description": "I occasionally review my expenses but don't have a fixed plan"
            },
            {
              "value": "none",
              "label": "No tracking, spend freely",
              "description": "I don't keep track of expenses and spend based on what I feel like"
            }
          ],
          "defaultValue": "occasional"
        },
        {
          "id": "hobbies",
          "type": "multi-choice",
          "label": "What hobbies do you enjoy?",
          "description": "Select all that apply",
          "required": false,
          "options": [
            { "value": "reading", "label": "Reading" },
            { "value": "sports", "label": "Sports & Exercise" },
            { "value": "music", "label": "Music" },
            { "value": "gaming", "label": "Gaming" },
            { "value": "art", "label": "Art & Crafts" },
            { "value": "cooking", "label": "Cooking" }
          ],
          "minSelections": 1,
          "maxSelections": 4,
          "defaultValue": []
        },
        {
          "id": "exerciseRegularly",
          "type": "boolean",
          "label": "Do you exercise regularly?",
          "description": "Consider 'regularly' as at least 3 times per week",
          "required": true,
          "trueLabel": "Yes",
          "falseLabel": "No",
          "defaultValue": false
        },
        {
          "id": "dailyActivities",
          "type": "matrix",
          "label": "How much do you enjoy these daily activities?",
          "description": "Rate each activity from 1 (dislike) to 5 (love)",
          "required": true,
          "subQuestions": [
            { "id": "work", "label": "Work/Study" },
            { "id": "socializing", "label": "Socializing" },
            { "id": "relaxing", "label": "Relaxing" },
            { "id": "learning", "label": "Learning new things" }
          ],
          "scaleOptions": [
            { "value": 1, "label": "1" },
            { "value": 2, "label": "2" },
            { "value": 3, "label": "3" },
            { "value": 4, "label": "4" },
            { "value": 5, "label": "5" }
          ]
        }
      ]
    }
  ]
}
